# ---------------------------------------------------------------------------
# TuniTrip AI — environment variables
# Copy this file to `.env.local` and fill in your own values.
#
# SECURITY: Vite exposes a variable to browser code if, and only if, its name
# starts with VITE_. Anything without that prefix stays server-side. Never add
# the VITE_ prefix to a provider key.
# ---------------------------------------------------------------------------

# --- Browser-safe (bundled into the client) --------------------------------

# Supabase project URL, e.g. https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase "anon" / publishable key. Safe for the browser — RLS protects data.
VITE_SUPABASE_ANON_KEY=

# --- Sign-in (no variable required) ----------------------------------------
#
# Google is the only identity provider. There is no email/password path in the
# codebase, so there is nothing to configure here — but the provider must be
# switched on once, outside the repository:
#
#   1. Google Cloud console -> Credentials -> OAuth 2.0 Client ID (Web)
#        Authorised redirect URI:
#          https://<project-ref>.supabase.co/auth/v1/callback
#   2. Supabase Dashboard -> Authentication -> Providers -> Google
#        paste the client ID and secret, enable
#   3. Supabase Dashboard -> Authentication -> URL Configuration
#        add your site URL and http://localhost:5173 to the redirect allow-list
#
# Until step 2 is done, the "Continue with Google" button reports the
# provider's own error rather than pretending to sign anyone in.

# --- Server-side only (NEVER prefix these with VITE_) -----------------------

# Google Gemini API key — https://aistudio.google.com/apikey
#
# Read by:
#   * the Vite dev proxy, via loadEnv() in vite.config.ts (Node side only)
#   * the deployed Edge Function, via `supabase secrets set GEMINI_API_KEY=...`
#
# If this ever appears as VITE_GEMINI_API_KEY it is published to every visitor.
GEMINI_API_KEY=

# Supabase service role key — bypasses RLS. Read ONLY by the offline embedding
# pipeline (npm run db:embed), which is the sole writer of place_embeddings.
# Never ship it to the browser, and never put it in an Edge Function that
# serves user requests.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Which commands need what
#
#   npm run dev            VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY
#                          REQUIRED. There is no local-catalogue fallback any
#                          more: without these the app boots, but every list
#                          renders its error state, and sign-in is disabled.
#
#   npm run db:embed       GEMINI_API_KEY            SERVER ONLY
#                          VITE_SUPABASE_URL         safe client config
#                          SUPABASE_SERVICE_ROLE_KEY SERVER ONLY
#
#   npm run db:verify-rag  GEMINI_API_KEY            SERVER ONLY
#                          VITE_SUPABASE_URL         safe client config
#                          VITE_SUPABASE_ANON_KEY    safe client config
#
# Add --dry-run to db:embed to exercise the local half with no credentials.
# ---------------------------------------------------------------------------

# Conversational model for the NOVA agent. Server-side only.
#
# Defaults to gemini-3.8-flash. IMPORTANT: on the Gemini free tier that model is
# capped at 20 generateContent requests PER DAY, and one NOVA message costs two
# — about ten messages a day, which is not enough to demo. gemini-3.5-flash-lite
# was verified working with headroom. Check your own limits at
# https://ai.dev/rate-limit before a demo.
# NOVA_MODEL=gemini-3.5-flash-lite

# --- Optional -------------------------------------------------------------

# Overrides where the browser posts NOVA messages. Safe to expose: it is only a
# URL. Defaults to /api/nova in development (the Vite proxy) and to
# <VITE_SUPABASE_URL>/functions/v1/nova-agent in production.
# VITE_NOVA_ENDPOINT=
